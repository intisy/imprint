{
  "id": "docker",
  "name": "Docker",
  "category": "containers",
  "install": {
    "arch": {
      "packages": [
        "docker",
        "docker-compose"
      ],
      "services": [
        "docker"
      ]
    },
    "debian": {
      "packages": [
        "docker.io",
        "docker-compose-v2"
      ],
      "services": [
        "docker"
      ]
    },
    "fedora": {
      "packages": [
        "docker-ce",
        "docker-ce-cli",
        "containerd.io",
        "docker-compose-plugin"
      ],
      "repo_setup": [
        "dnf install -y dnf-plugins-core",
        "dnf config-manager --add-repo https://download.docker.com/linux/fedora/docker-ce.repo"
      ]
    }
  }
}
