{
  "id": "virtualization",
  "name": "Virtualization (libvirt/QEMU)",
  "category": "utilities",
  "install": {
    "arch": {
      "packages": [
        "virt-manager",
        "qemu-full",
        "libvirt",
        "edk2-ovmf",
        "dnsmasq"
      ],
      "services": [
        "libvirtd"
      ]
    },
    "fedora": {
      "packages": [
        "virt-manager",
        "qemu-kvm",
        "libvirt",
        "edk2-ovmf",
        "dnsmasq"
      ],
      "services": [
        "libvirtd"
      ]
    }
  }
}
